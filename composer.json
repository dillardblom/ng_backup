{
	"name": "dillardblom/ng_backup",
	"description": "NG Backup: encrypted, incremental Nextcloud backups",
	"license": "AGPL-3.0-or-later",
	"type": "project",
	"autoload": {
		"psr-4": {
			"OCA\\NgBackup\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\NgBackup\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"nextcloud/ocp": "dev-stable32",
		"vimeo/psalm": "^6.0"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.27"
		}
	},
	"scripts": {
		"test:unit": "phpunit -c tests/phpunit.xml --testsuite unit",
		"psalm": "psalm --no-cache --threads=1"
	}
}
