<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>ng_backup</id>
    <name>NG Backup</name>
    <summary>Encrypted, incremental backups of your Nextcloud with restore from the web interface</summary>
    <description><![CDATA[Beta: scheduled, encrypted, incremental backups of the database, config and data
directory to S3, SFTP, WebDAV, FTP, SMB or a local path, with restore of files and folders, of
single users (via user_migration) and of the whole server onto a fresh installation. Tested
thoroughly and usable alongside your current backup, but not yet a drop-in replacement for it.
See the README for known limitations and the recovery kit before relying on it.]]></description>
    <version>0.9.0</version>
    <licence>agpl</licence>
    <author>Dillard Blom</author>
    <namespace>NgBackup</namespace>
    <category>tools</category>
    <bugs>https://github.com/dillardblom/ng_backup/issues</bugs>
    <dependencies>
        <php min-version="8.1"/>
        <lib>sodium</lib>
        <nextcloud min-version="32" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\NgBackup\BackgroundJob\BackupJob</job>
    </background-jobs>
    <commands>
        <command>OCA\NgBackup\Command\KeyInit</command>
        <command>OCA\NgBackup\Command\KeyKit</command>
        <command>OCA\NgBackup\Command\KeyConfirm</command>
        <command>OCA\NgBackup\Command\TargetBackends</command>
        <command>OCA\NgBackup\Command\TargetAdd</command>
        <command>OCA\NgBackup\Command\TargetList</command>
        <command>OCA\NgBackup\Command\TargetRemove</command>
        <command>OCA\NgBackup\Command\RunBackup</command>
        <command>OCA\NgBackup\Command\Status</command>
        <command>OCA\NgBackup\Command\ListSnapshots</command>
        <command>OCA\NgBackup\Command\Browse</command>
        <command>OCA\NgBackup\Command\Restore</command>
        <command>OCA\NgBackup\Command\Prune</command>
        <command>OCA\NgBackup\Command\Retention</command>
        <command>OCA\NgBackup\Command\TargetAppendOnly</command>
        <command>OCA\NgBackup\Command\TargetTrustCurrent</command>
        <command>OCA\NgBackup\Command\TargetLimit</command>
        <command>OCA\NgBackup\Command\Trash</command>
        <command>OCA\NgBackup\Command\TrashRestore</command>
        <command>OCA\NgBackup\Command\KeySlots</command>
        <command>OCA\NgBackup\Command\KeySlotAdd</command>
        <command>OCA\NgBackup\Command\KeySlotReplace</command>
        <command>OCA\NgBackup\Command\KeySlotRemove</command>
        <command>OCA\NgBackup\Command\BackupUser</command>
        <command>OCA\NgBackup\Command\RestoreUser</command>
        <command>OCA\NgBackup\Command\KeyImport</command>
        <command>OCA\NgBackup\Command\RestoreFull</command>
        <command>OCA\NgBackup\Command\Verify</command>
    </commands>
    <settings>
        <admin>OCA\NgBackup\Settings\Admin</admin>
        <admin-section>OCA\NgBackup\Settings\AdminSection</admin-section>
    </settings>
</info>
