<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>ng_backup</id>
    <name>NG Backup</name>
    <summary>Encrypted, incremental backups of your Nextcloud with restore from the web interface</summary>
    <description><![CDATA[Work in progress, not ready for use.]]></description>
    <version>0.0.4</version>
    <licence>agpl</licence>
    <author>Dillard Blom</author>
    <namespace>NgBackup</namespace>
    <category>tools</category>
    <bugs>https://github.com/dillardblom/ng_backup/issues</bugs>
    <dependencies>
        <php min-version="8.1"/>
        <lib>sodium</lib>
        <nextcloud min-version="32" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\NgBackup\BackgroundJob\BackupJob</job>
    </background-jobs>
    <commands>
        <command>OCA\NgBackup\Command\KeyInit</command>
        <command>OCA\NgBackup\Command\KeyKit</command>
        <command>OCA\NgBackup\Command\KeyConfirm</command>
        <command>OCA\NgBackup\Command\TargetBackends</command>
        <command>OCA\NgBackup\Command\TargetAdd</command>
        <command>OCA\NgBackup\Command\TargetList</command>
        <command>OCA\NgBackup\Command\TargetRemove</command>
        <command>OCA\NgBackup\Command\RunBackup</command>
        <command>OCA\NgBackup\Command\Status</command>
        <command>OCA\NgBackup\Command\ListSnapshots</command>
        <command>OCA\NgBackup\Command\Browse</command>
        <command>OCA\NgBackup\Command\Restore</command>
    </commands>
</info>
